{
  "name": "pi-orb",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/mock-openai",
    "packages/luna",
    "packages/native-image",
    "apps/control-plane",
    "apps/orb-runtime",
    "apps/web"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-prebuild-permissions.mjs",
    "test": "vitest run && npm run test:infra",
    "test:infra": "node --test infra/foundation/state_split.test.mjs infra/foundation/adopt.test.mjs infra/foundation/iam_contract.test.mjs infra/smoke-timeout.contract.test.mjs infra/smoke-cleanup.test.mjs && python3 -m unittest infra/smoke_preview_test.py infra/artifact_guard_test.py infra/release_state_test.py infra/release_retire_test.py infra/release_report_test.py infra/release_preflight_test.py && infra/native-vm/test.sh",
    "dev:frontend": "npm run dev:frontend --workspace @pi-orb/web",
    "dev:local": "PI_ORB_HOST_PROVIDER=process PI_ORB_DATABASE_KIND=pglite npm run dev --workspace @pi-orb/control-plane",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:e2e:frontend": "vitest run --config e2e/vitest.config.ts e2e/frontend-session.e2e.test.ts e2e/frontend-mobile.e2e.test.ts",
    "test:e2e:mobile": "vitest run --config e2e/vitest.config.ts e2e/frontend-mobile.e2e.test.ts",
    "native-image:build": "npm run build --workspace @pi-orb/native-image --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
