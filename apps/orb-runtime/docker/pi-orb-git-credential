#!/bin/sh
# pi-orb git credential helper (DESIGN.md §15.3): answers `get` for
# https://github.com with a fresh short-lived broker token. Wired via the
# image's system gitconfig, and via GIT_CONFIG_* on process hosts; silent for
# every other host.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$script_dir" = /usr/local/bin ]; then
  app_root=/app
else
  app_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
fi

exec node "$app_root/apps/orb-runtime/src/gh/cli.ts" credential "$@"
