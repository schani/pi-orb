#!/bin/sh
# In-orb pi-orb CLI dispatcher. The image carries application source at /app;
# the process host puts this repository copy on PATH, so derive its root there.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$script_dir" = /usr/local/bin ]; then
  app_root=/app
else
  app_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
fi

case "${1:-}" in
  help|--help|-h)
    exec node "$app_root/apps/orb-runtime/src/cli-help-entry.ts" "$@"
    ;;
esac
case "${2:-}" in
  --help|-h)
    exec node "$app_root/apps/orb-runtime/src/cli-help-entry.ts" "$@"
    ;;
esac

case "${1:-}" in
  id-token)
    shift
    exec node "$app_root/apps/orb-runtime/src/id-token/cli.ts" "$@"
    ;;
  spawn)
    shift
    exec node "$app_root/apps/orb-runtime/src/spawn/cli.ts" "$@"
    ;;
  archive)
    shift
    exec node "$app_root/apps/orb-runtime/src/archive/cli.ts" "$@"
    ;;
  delete)
    shift
    exec node "$app_root/apps/orb-runtime/src/delete/cli.ts" "$@"
    ;;
  sleep)
    shift
    exec node "$app_root/apps/orb-runtime/src/sleep/cli.ts" "$@"
    ;;
  send)
    shift
    exec node "$app_root/apps/orb-runtime/src/send/cli.ts" "$@"
    ;;
  alert)
    shift
    exec node "$app_root/apps/orb-runtime/src/alert/cli.ts" "$@"
    ;;
  host)
    shift
    exec node "$app_root/apps/orb-runtime/src/hosting/cli.ts" "$@"
    ;;
  self|orbs|transcript)
    exec node "$app_root/apps/orb-runtime/src/inspection/cli.ts" "$@"
    ;;
  *)
    exec node "$app_root/apps/orb-runtime/src/cli-help-entry.ts" "$@"
    ;;
esac
