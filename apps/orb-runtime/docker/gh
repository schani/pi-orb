#!/bin/sh
# pi-orb gh shim (DESIGN.md §15.3): sits before /usr/bin/gh on PATH, fetches
# a fresh short-lived GitHub token from the credential broker, and execs the
# real gh with GH_TOKEN set. A caller-provided GH_TOKEN wins; on fetch
# failure the message lands on stderr and gh runs unauthenticated.
if [ -z "${GH_TOKEN:-}" ] && [ -n "${PI_ORB_RUNTIME_TOKEN:-}" ]; then
  token="$(node /app/apps/orb-runtime/src/gh/cli.ts print)" && {
    GH_TOKEN="$token"
    export GH_TOKEN
  }
fi
exec /usr/bin/gh "$@"
