{
  "name": "invalidation drops the entry and its owner, and advances the fence",
  "steps": [
    { "op": "acquire", "args": { "owner": "oa", "orbId": "a", "projectId": "p1" } },
    {
      "op": "publish",
      "args": {
        "owner": "oa",
        "snapshot": {
          "sessionId": "s1",
          "records": [{ "id": "r1", "text": "hello" }],
          "afterRecordId": "r1",
          "headId": "r1"
        }
      },
      "expect": { "admission": "stored" }
    },
    { "op": "acquire", "args": { "owner": "ob", "orbId": "b", "projectId": "p2" } },
    {
      "op": "publish",
      "args": {
        "owner": "ob",
        "snapshot": {
          "sessionId": "s2",
          "records": [{ "id": "r2", "text": "hello" }],
          "afterRecordId": "r2",
          "headId": "r2"
        }
      },
      "expect": { "admission": "stored" }
    },
    { "op": "invalidate", "args": { "orbId": "a" } },
    { "op": "get", "args": { "orbId": "a" }, "expect": { "hit": null } },
    {
      "op": "publish",
      "args": {
        "owner": "oa",
        "snapshot": {
          "sessionId": "s1",
          "records": [{ "id": "r1", "text": "hello" }],
          "afterRecordId": "r1",
          "headId": "r1"
        }
      },
      "expect": { "admission": "stale" }
    },
    { "op": "invalidate_project", "args": { "projectId": "p2" } },
    { "op": "get", "args": { "orbId": "b" }, "expect": { "hit": null } }
  ],
  "expect": { "entries": [], "bytes": 0, "owners": 0, "invalidationEpoch": 3 }
}
