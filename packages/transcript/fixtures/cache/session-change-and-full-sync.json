{
  "name": "a full sync clears the entry and the replacement session never concatenates",
  "steps": [
    { "op": "acquire", "args": { "owner": "own", "orbId": "a", "projectId": "p1" } },
    {
      "op": "publish",
      "args": {
        "owner": "own",
        "snapshot": {
          "sessionId": "s1",
          "records": [{ "id": "r1", "text": "hello" }],
          "afterRecordId": "r1",
          "headId": "r1"
        }
      },
      "expect": { "admission": "stored" }
    },
    { "op": "clear", "args": { "owner": "own" } },
    { "op": "get", "args": { "orbId": "a" }, "expect": { "hit": null } },
    {
      "op": "publish",
      "args": {
        "owner": "own",
        "snapshot": {
          "sessionId": "s2",
          "records": [{ "id": "r9", "text": "hello" }],
          "afterRecordId": "r9",
          "headId": "r9"
        }
      },
      "expect": { "admission": "stored" }
    },
    {
      "op": "get",
      "args": { "orbId": "a" },
      "expect": {
        "hit": { "sessionId": "s2", "recordIds": ["r9"], "afterRecordId": "r9", "headId": "r9" }
      }
    }
  ],
  "expect": {
    "entries": [
      {
        "orbId": "a",
        "projectId": "p1",
        "sessionId": "s2",
        "recordIds": ["r9"],
        "afterRecordId": "r9",
        "headId": "r9",
        "bytes": 870
      }
    ],
    "bytes": 870,
    "owners": 1,
    "invalidationEpoch": 0
  }
}
